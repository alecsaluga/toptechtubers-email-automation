# Postgres connection string (Prisma Postgres or any Postgres instance)
DATABASE_URL=

# AES-256-GCM key (32 bytes, base64) used to encrypt credentials stored in the DB.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Secret used to sign dashboard session cookies
SESSION_SECRET=

# Shared secret checked by the Gmail polling cron endpoint (/api/cron/poll-gmail)
CRON_SECRET=

# Must exactly match an Authorized redirect URI on the Google Cloud OAuth client
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Optional fallbacks. Normally entered in the Command Center UI and stored encrypted in the DB.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=
